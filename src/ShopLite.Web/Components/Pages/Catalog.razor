@page "/catalog"
@attribute [StreamRendering(true)]
@using System.Globalization
@using Polly.Timeout
@inject CatalogApiClient CatalogApi
@inject ILogger<Catalog> Logger

<PageTitle>Catalogue</PageTitle>

<h1>Catalogue</h1>

@if (errorMessage is not null)
{
    <div class="alert alert-warning">@errorMessage</div>
}
else if (products is null)
{
    <p><em>Chargement...</em></p>
}
else if (products.Length == 0)
{
    <p>Aucun produit pour le moment.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Produit</th>
                <th>Prix</th>
                <th>Stock</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Price.ToString("C", fr)</td>
                    <td>@product.Stock</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private static readonly CultureInfo fr = CultureInfo.GetCultureInfo("fr-FR");
    private ProductDto[]? products;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await CatalogApi.GetProductsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TimeoutRejectedException)
        {
            Logger.LogError(ex, "Impossible de récupérer le catalogue");
            errorMessage = "Le catalogue est momentanément indisponible. Réessayez dans quelques instants.";
        }
    }
}